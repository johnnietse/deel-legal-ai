# =============================================================================
# Deel Lab Legal AI System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# --- Required: API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated backup Gemini keys for the embedder pool (key rotation on rate limits).
# With only GEMINI_API_KEY set, the pool collapses to a single key.
GEMINI_BACKUP_KEYS=
# Dedicated Gemini 2.5 Pro
The user wants me to the embedder pool so ingestion never starves search.
SEARCH_GEMINI_API_KEY=
SEARCH_GEMINI_BACKUP_KEYS=
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq (Fast Llama3 inference) - Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Required: Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/deel_legal

# --- Optional: Vector Store Backend ---
# Options: "pinecone" (managed, default), "milvus" (self-hosted)
VECTOR_STORE_BACKEND=pinecone

# Pinecone (when VECTOR_STORE_BACKEND=pinecone)
PINECONE_INDEX_NAME=deel-legal-cases
PINECONE_ENVIRONMENT=us-east-1

# Milvus (when VECTOR_STORE_BACKEND=milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=

# --- Optional: Sparse Retrieval (BM25) Backend ---
# Options: "elasticsearch" (production, default), "local" (in-memory dev)
BM25_BACKEND=elasticsearch

# Elasticsearch (when BM25_BACKEND=elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ES_SECURITY_ENABLED=false
ELASTIC_PASSWORD=

# RAGFlow-style feature gates
KEYWORD_BOOST_ENABLED=true
PARENT_CHILD_ENABLED=true
GRAPHRAG_ENABLED=true
RERANKER_BACKEND=off

# --- Minio / S3-compatible Storage (for Milvus) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=${MINIO_ACCESS_KEY}
MINIO_ROOT_PASSWORD=${MINIO_SECRET_KEY}

# --- Optional: HNSW Index Tuning (ByteDance §4.2.1) ---
# Options: "development", "production" (default), "high_recall", "billion_scale"
HNSW_PRESET=production

# --- Optional: Cross-Region Deployment (ByteDance §8.3) ---
PRIMARY_REGION=us-east-1
REPLICA_REGIONS=eu-west-1,ap-southeast-1

# --- Optional: LoRA Fine-Tuning ---
# Base LLM model for fine-tuning (HuggingFace model ID)
BASE_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- OpenJustice.ai SaaS Configuration ---

# JWT Authentication (REQUIRED - no default fallback)
JWT_SECRET_KEY=generate-a-strong-random-secret-here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# Set DEV_MODE=1 to enable Google OAuth development placeholder (DO NOT use in production)

# --- Optional: Logging ---
LOG_LEVEL=INFO
