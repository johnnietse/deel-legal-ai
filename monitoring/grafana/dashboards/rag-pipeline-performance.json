{
  "__inputs": [],
  "__requires": [],
  "title": "RAG Pipeline Performance",
  "uid": "rag-pipeline-performance",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["openjustice", "rag", "ml"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "RAG Query Latency — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": ["mean", "p95", "p99"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "RAG Queries Per Second (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(rag_query_total[5m])",
          "legendFormat": "QPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "RAG Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(rag_query_errors_total[5m]) / rate(rag_query_total[5m]) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "RAG Pipeline Stage Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": ["mean", "p95"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(rag_stage_duration_seconds_sum{stage=\"embedding\"}[5m]) / rate(rag_stage_duration_seconds_count{stage=\"embedding\"}[5m])",
          "legendFormat": "Embedding"
        },
        {
          "expr": "rate(rag_stage_duration_seconds_sum{stage=\"retrieval\"}[5m]) / rate(rag_stage_duration_seconds_count{stage=\"retrieval\"}[5m])",
          "legendFormat": "Retrieval"
        },
        {
          "expr": "rate(rag_stage_duration_seconds_sum{stage=\"reranking\"}[5m]) / rate(rag_stage_duration_seconds_count{stage=\"reranking\"}[5m])",
          "legendFormat": "Reranking"
        },
        {
          "expr": "rate(rag_stage_duration_seconds_sum{stage=\"llm_generation\"}[5m]) / rate(rag_stage_duration_seconds_count{stage=\"llm_generation\"}[5m])",
          "legendFormat": "LLM Generation"
        },
        {
          "expr": "rate(rag_stage_duration_seconds_sum{stage=\"citation_check\"}[5m]) / rate(rag_stage_duration_seconds_count{stage=\"citation_check\"}[5m])",
          "legendFormat": "Citation Check"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        }
      }
    },
    {
      "id": 5,
      "title": "Vector Store Query Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": ["mean", "p95"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(milvus_query_duration_seconds_sum[5m]) / rate(milvus_query_duration_seconds_count[5m])",
          "legendFormat": "Milvus"
        },
        {
          "expr": "rate(elasticsearch_query_duration_seconds_sum[5m]) / rate(elasticsearch_query_duration_seconds_count[5m])",
          "legendFormat": "Elasticsearch"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "showPoints": "never" }
        }
      }
    },
    {
      "id": 6,
      "title": "Token Usage & Cost (Last 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(rag_token_usage_total[24h]))",
          "legendFormat": "Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "decimals": 0
        }
      }
    },
    {
      "id": 7,
      "title": "RAG Query Result Count Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "calcs": [], "displayMode": "hidden", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(rag_results_count_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        }
      }
    },
    {
      "id": 8,
      "title": "Citation Accuracy Score",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "avg(rag_citation_accuracy_score)",
          "legendFormat": "Accuracy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s"
}
